root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 100

[*.{kt,kts}]
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_packages_to_use_import_on_demand = androidx.compose.foundation.layout.*,androidx.compose.material3.*,androidx.compose.runtime.*,kotlinx.coroutines.flow.*,com.example.drivecare.core.model.*,com.example.drivecare.core.ui.*,com.example.drivecare.domain.*
ktlint_standard_function-signature = enabled
ktlint_standard_multiline-expression-wrapping = enabled
