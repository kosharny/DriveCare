    <string name="privacy">About &amp; Privacy</string>
    <string name="privacy_body">DriveCare stores ownership records on this device. Optional AI sends selected vehicle details, your question and a chosen record summary to Google. Photos, receipts and location are not sent. Purchases are processed by Google Play and RevenueCat. No account, ads, tracking or automatic cloud sync. Deleting local data does not refund purchases. Make/model suggestions use NHTSA; the model lookup sends only the selected make.</string>
    <string name="unlock_pro">Unlock Pro</string>
    <string name="pro_title">DriveCare Pro</string>
    <string name="one_time">One-time purchase · permanent unlock</string>
    <string name="pro_benefits">Multiple active vehicles, advanced period and category comparisons, workshop breakdowns and PDF reports. Basic records, reminders, statistics, CSV and backups stay free. AI has the same availability and fair-use limits in both tiers.</string>
